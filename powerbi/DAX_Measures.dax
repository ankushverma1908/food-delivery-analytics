Total Orders = DISTINCTCOUNT(FactOrders[order_id])
Delivered Orders = CALCULATE([Total Orders], FactOrders[order_status]="Delivered")
Cancelled Orders = CALCULATE([Total Orders], FactOrders[order_status]="Cancelled")
Delayed Orders = CALCULATE([Total Orders], FactOrders[order_status]="Delayed")
Delivered Revenue = CALCULATE(SUM(FactOrders[net_amount]), FactOrders[order_status]="Delivered")
Average Order Value = DIVIDE([Delivered Revenue],[Delivered Orders])
Delivery Success Rate = DIVIDE([Delivered Orders],[Total Orders])
Cancellation Rate = DIVIDE([Cancelled Orders],[Total Orders])
Delay Rate = DIVIDE([Delayed Orders],[Total Orders])
Average Delivery Time = CALCULATE(AVERAGE(FactOrders[delivery_time_mins]),FactOrders[order_status]="Delivered")
Average Customer Rating = CALCULATE(AVERAGE(FactOrders[customer_rating]),FactOrders[order_status]="Delivered")
Unique Customers = DISTINCTCOUNT(FactOrders[customer_id])
